# ============================================================
# BALMANDAISA BY DAC — Environment Configuration Example
# ============================================================
# Copy this file to .env.local for local development, or add these
# variables in your Vercel Project Settings (Environment Variables).

# --- GOOGLE SHEETS LIVE AVAILABILITY CONFIGURATION ---

# 1. Google Spreadsheet ID (from the Google Sheets URL)
# Example URL: https://docs.google.com/spreadsheets/d/1BxiMVs0XRA5nFMdKvBdBZjgmUUqptlbs74OgvE2upms/edit
GOOGLE_SHEET_ID=1xPq8jD76535wK85Fm2gG8Q2h72x8a54_placeholder

# 2. Google Sheet Tab Name (default is 'Sheet1' or 'BALMANDAISA STOCK')
GOOGLE_SHEET_NAME=Sheet1

# 3. Google Cloud Service Account Authentication (Option A: Recommended for Vercel)
# Paste the entire contents of your Google Service Account JSON key as a single-line string.
GOOGLE_SERVICE_ACCOUNT_KEY='{"type":"service_account","project_id":"your-project","private_key_id":"key-id","private_key":"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n","client_email":"your-service-account@your-project.iam.gserviceaccount.com"}'

# 4. Google Cloud Service Account Authentication (Option B: Individual fields)
# GOOGLE_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
